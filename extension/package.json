{
  "name": "parallel-code",
  "displayName": "parallel-code",
  "description": "",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.96.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "parallel-sidebar-view",
          "title": "Parallel",
          "icon": "media/server.svg"
        }
      ]
    },
    "views": {
      "explorer": [
        {
          "id": "parallel.session",
          "name": "Parallel"
        }
      ]
    },
    "menus": {
      "view/item/context": [
        {
          "command": "parallel-code.JoinSession",
          "when": "view == parallel.session && viewItem == sessions",
          "group": "inline"
        },
        {
          "command": "parallel-code.NewSession",
          "when": "view == parallel.session && viewItem == sessions",
          "group": "inline"
        }
      ]
    },
    "commands": [
      {
        "command": "parallel-code.helloWorld",
        "title": "Hello World"
      },
      {
        "command": "parallel-code.PasteSelection",
        "category": "Parallel Code",
        "title": "Paste Selection"
      },
      {
        "command": "parallel-code.Authenticate",
        "category": "Parallel Code",
        "title": "Authenticate"
      },
      {
        "command": "parallel-code.refresh",
        "category": "Parallel Code",
        "title": "Refresh"
      },
      {
        "command": "parallel-code.showWebView",
        "category": "Parallel Code",
        "title": "Show Web View"
      },
      {
        "command": "parallel-code.AskQuestion",
        "category": "Parallel Code",
        "title": "Ask a Question"
      },
      {
        "command": "parallel-code.NewSession",
        "category": "Parallel Code",
        "title": "New Session"
      },
      {
        "command": "parallel-code.JoinSession",
        "category": "Parallel Code",
        "title": "Join Session"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "pnpm run package",
    "compile": "webpack",
    "watch": "concurrently \"rollup -c -w\" webpack --watch",
    "package": "webpack --mode production --devtool hidden-source-map",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "pnpm run compile-tests && pnpm run compile && pnpm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^14.0.0",
    "@rollup/plugin-node-resolve": "^8.4.0",
    "@rollup/plugin-typescript": "^6.1.0",
    "@sveltejs/adapter-auto": "^4.0.0",
    "@sveltejs/vite-plugin-svelte": "^5.0.3",
    "@tsconfig/svelte": "^1.0.13",
    "@types/btoa": "1.2.5",
    "@types/glob": "7.2.0",
    "@types/googlemaps": "3.43.3",
    "@types/jsonwebtoken": "^9.0.8",
    "@types/mocha": "^8.2.3",
    "@types/node": "~12.20.55",
    "@types/node-fetch": "2.6.12",
    "@types/polka": "^0.5.7",
    "@types/vscode": "^1.96.0",
    "@typescript-eslint/eslint-plugin": "^4.33.0",
    "@typescript-eslint/parser": "^4.33.0",
    "@vscode/test-cli": "^0.0.10",
    "@vscode/test-electron": "^2.4.1",
    "concurrently": "^5.3.0",
    "date-fns": "2.30.0",
    "eslint": "^7.32.0",
    "glob": "7.2.3",
    "jsonwebtoken": "^9.0.2",
    "mocha": "8.4.0",
    "node-fetch": "2.7.0",
    "reconnecting-websocket": "4.4.0",
    "rollup": "^2.79.2",
    "rollup-plugin-css-only": "3.1.0",
    "rollup-plugin-livereload": "2.0.5",
    "rollup-plugin-svelte": "^6.1.1",
    "rollup-plugin-terser": "^7.0.2",
    "svelte": "^3.59.2",
    "svelte-check": "^1.6.0",
    "svelte-preprocess": "^4.10.7",
    "svelte2tsx": "^0.7.34",
    "ts-loader": "^8.4.0",
    "tslib": "2.8.1",
    "typescript": "^4.9.5",
    "vite": "^6.0.7",
    "vscode-test": "1.6.1",
    "webpack": "^5.95.0",
    "webpack-cli": "^4.10.0"
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "polka": "^0.5.2",
    "ws": "^8.18.1",
    "y-protocols": "^1.0.6",
    "y-websocket": "^2.1.0",
    "yjs": "^13.6.23"
  }
}
