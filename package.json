{
  "name": "parallel-code",
  "displayName": "parallel-code",
  "description": "",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.96.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "parallel-sidebar-view",
          "title": "Parallel",
          "icon": "media/server.svg"
        }
      ]
    },
    "views": {
      "parallel-sidebar-view": [
        {
          "type": "webview",
          "id": "parallel-sidebar",
          "name": "Parallel",
          "icon": "media/server.svg",
          "contextualTitle": "Parallel"
        }
      ]
    },
    "commands": [
      {
        "command": "parallel-code.helloWorld",
        "title": "Hello World"
      },
      {
        "command": "parallel-code.PasteSelection",
        "category": "Parallel Code",
        "title": "Paste Selection"
      },
      {
        "command": "parallel-code.refresh",
        "category": "Parallel Code",
        "title": "Refresh"
      },
      {
        "command": "parallel-code.showWebView",
        "category": "Parallel Code",
        "title": "Show Web View"
      },
      {
        "command": "parallel-code.AskQuestion",
        "category": "Parallel Code",
        "title": "Ask a Question"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "pnpm run package",
    "compile": "webpack",
    "watch": "concurrently \"rollup -c -w\" webpack --watch",
    "package": "webpack --mode production --devtool hidden-source-map",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "pnpm run compile-tests && pnpm run compile && pnpm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^28.0.2",
    "@rollup/plugin-node-resolve": "^16.0.0",
    "@rollup/plugin-typescript": "^6.1.0",
    "@sveltejs/adapter-auto": "^4.0.0",
    "@sveltejs/vite-plugin-svelte": "^5.0.3",
    "@tsconfig/svelte": "^5.0.4",
    "@types/mocha": "^10.0.10",
    "@types/node": "20.x",
    "@types/vscode": "^1.96.0",
    "@typescript-eslint/eslint-plugin": "^8.17.0",
    "@typescript-eslint/parser": "^8.17.0",
    "@vscode/test-cli": "^0.0.10",
    "@vscode/test-electron": "^2.4.1",
    "eslint": "^9.16.0",
    "rollup": "^2.79.2",
    "rollup-plugin-svelte": "^7.2.2",
    "rollup-plugin-terser": "^7.0.2",
    "svelte": "^5.19.0",
    "svelte-check": "^4.1.4",
    "svelte-preprocess": "^6.0.3",
    "svelte2tsx": "^0.7.34",
    "ts-loader": "^9.5.1",
    "typescript": "^5.7.3",
    "vite": "^6.0.7",
    "webpack": "^5.95.0",
    "webpack-cli": "^5.1.4"
  },
  "dependencies": {
    "concurrently": "^9.1.2"
  }
}
